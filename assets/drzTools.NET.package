<?xml version="1.0" encoding="utf-8" ?>
<ApplicationPackage xmlns="hostApplicationPackage/v01"
                    Name="drzTools">
	<!-- Возможно есть смысл не прописывать здесь все модули, а грузить лиспом -->
	<Components>
		<!-- BGTOOLS.LSP -->
		<ComponentEntry AppName="BGTOOLS.LSP"
		                ModuleName="BGTOOLS.LSP/bgtools 3.11b2_Nc_22.lsp"
		                ModuleType="LISP"/>
		<!-- BlockFix.LSP лиспы от сообщества-->
		<ComponentEntry AppName="BlockFix.LSP"
		                ModuleName="BlockFix.LSP/AutoRun_BlockFix.lsp"
		                ModuleType="LISP"/>
		<!-- BlockFix.NC -->
		<ComponentEntry AppName="BlockFix.NC"
		                ModuleName="/BlockFix.NC/BlockFix.NC.dll"
		                ModuleType="MGD"/>
		<!-- ChangeDBmod.MC-->
		<ComponentEntry AppName="ChangeDBmod.MC"
		                ModuleName="ChangeDBmod.MC/ChangeDBmod.MC.dll"
		                ModuleType="MGD"/>
		<!-- docProps.NC -->
		<ComponentEntry AppName="docProps.NC"
		                ModuleName="docProps.NC/docProps.NC.dll"
		                ModuleType="MGD"/>
		<!-- drzTools.NC -->
		<ComponentEntry AppName="drzTools.NC"
		                ModuleName="drzTools.NC/drzTools.NC.dll"
		                ModuleType="MGD"/>
		<!-- Group.LSP утилиты, работа с группами -->
		<ComponentEntry AppName="Group.LSP"
		                ModuleName="Group.LSP/AutoRun_Group.lsp"
		                ModuleType="LISP"/>
		<!-- LFIO.NC фильтры слоев -->
		<ComponentEntry AppName="LFIO.NC"
		                ModuleName="LFIO.NC/LFIO.NC.dll"
		                ModuleType="MGD"/>
		<!-- Others.LSP утилиты, разное -->
		<ComponentEntry AppName="Others.LSP"
		                ModuleName="Others.LSP/AutoRun_Others.lsp"
		                ModuleType="LISP"/>
		<!-- Text.LSP утилиты, работа с текстом -->
		<ComponentEntry AppName="Text.LSP"
		                ModuleName="Text.LSP/AutoRun_Text.lsp"
		                ModuleType="LISP"/>
		<!-- drzTools menu -->
		<ConfigEntry FileName="/Resources/drzTools.cfg"
		             FileType="CFG"/>
		<!-- BGTOOLS menu -->
		<ConfigEntry FileName="/Resources/BGTOOLS.cfg"
		             FileType="CFG"/>
	</Components>
</ApplicationPackage>