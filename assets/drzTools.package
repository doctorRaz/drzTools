<?xml version="1.0" encoding="utf-8" ?>
<ApplicationPackage xmlns="hostApplicationPackage/v01"
                    Name="drzTools">
    <!-- Возможно есть смысл не прописывать здесь все модули, а грузить лиспом -->
    <Components>
        <!-- BlockFix -->
        <ComponentEntry AppName="BlockFix"
                        ModuleName="/BlockFix/BlockFix.NCad.dll"
                        ModuleType="MGD"/>
        <!-- docProps -->
        <ComponentEntry AppName="docProps"
                        ModuleName="docProps/docProps.NC.dll"
                        ModuleType="MGD"/>        
        <!-- LFIO фильтры слоев -->
        <ComponentEntry AppName="LFIO"
                        ModuleName="LFIO/LFIO_NC.dll"
                        ModuleType="MGD"/>
        <!-- BlockFix_LSP лиспы от сообщества-->
        <ComponentEntry AppName="BlockFix_LSP"
                        ModuleName="BlockFix_LSP/AutoRun_BlockFix.lsp"
                        ModuleType="LISP"/>
        <!-- BGTOOLS -->
        <ComponentEntry AppName="LISP"
                        ModuleName="BGTOOLS/bgtools 3.11b2_Nc_22.lsp"
                        ModuleType="LISP"/>
        <!-- утилиты, работа с текстом -->
        <ComponentEntry AppName="Text_LSP"
                        ModuleName="Text_LSP/AutoRun_Text.lsp"
                        ModuleType="LISP"/>
        <!-- утилиты, работа с группами -->
        <ComponentEntry AppName="Group_LSP"
                        ModuleName="Group_LSP/AutoRun_Group.lsp"
                        ModuleType="LISP"/>
          <!-- утилиты, разное -->
        <ComponentEntry AppName="Others_LSP"
                        ModuleName="Others_LSP/AutoRun_Others.lsp"
                        ModuleType="LISP"/>                
                        
                        
                        
                        
                        
        <!-- drzTools menu -->
        <ConfigEntry FileName="/Resources/drzTools.cfg"
                     FileType="CFG"/>
        <!-- BGTOOLS menu -->
        <ConfigEntry FileName="/Resources/BGTOOLS.cfg"
                     FileType="CFG"/>
    </Components>
</ApplicationPackage>
<!-- аннотативность -->
<!-- https://through-the-interface.typepad.com/through_the_interface/2007/04/making_autocad_.html -->
<!-- https://adn-cis.org/kak-sdelat-obektyi-autocad-annotativnyimi-v-.net.html -->