<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="$(SolutionDir)\Shared.NC.props" Condition="Exists('$(SolutionDir)\Shared.NC.props')" />
	<PropertyGroup>
		<TargetFramework>net6.0-windows</TargetFramework>
		<PlatformTarget>x64</PlatformTarget>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<Description>drzTools для nanoCAD 23-26</Description>
		<!--metadata-->
		<HostFamily>NC</HostFamily>
		<HostCode>n</HostCode>
	</PropertyGroup>
	<PropertyGroup>
		<DefineConstants>$(DefineConstants);NC;$(HostFamily)</DefineConstants>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="nanoCAD.Platform.NET" Version="23.1.6324.4405" />
	</ItemGroup>
	<!--Assembles-->
	<ItemGroup>
		<ProjectReference Include="..\SpecSPDS\Abstractions\Abstractions.csproj" />
		<ProjectReference Include="..\SpecSPDS\AddOnRuntime\AddOnRuntime.csproj" />
		<ProjectReference Include="..\SpecSPDS\Common.NC\Common.NC.csproj" />
	</ItemGroup>
	<!-- Генерация префикса команд из имени проекта для CommandMethod. -->
	<Target Name="GenerateCommandPrefix" BeforeTargets="CoreCompile">
		<PropertyGroup>
			<_CommandPrefixFile>$(IntermediateOutputPath)CommandPrefix.g.cs</_CommandPrefixFile>
			<_CommandPrefixValue>$(SolutionName)</_CommandPrefixValue>
		</PropertyGroup>
		<MakeDir Directories="$(IntermediateOutputPath)" />
		<WriteLinesToFile File="$(_CommandPrefixFile)" Overwrite="true" Lines="internal static class CommandPrefix { public const string Value = &quot;$(_CommandPrefixValue)&quot;%3B  }" />
		<ItemGroup>
			<Compile Include="$(_CommandPrefixFile)" />
		</ItemGroup>
	</Target>
</Project>
